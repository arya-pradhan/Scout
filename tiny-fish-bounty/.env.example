# Top-level Spectrum credentials (from your Photon dashboard).
PROJECT_ID=
PROJECT_SECRET=

# Claude (console.anthropic.com → API keys). Model defaults to claude-sonnet-5-5.
# (Haiku 4.5 was tested and skipped tool calls, e.g. claimed reminders it never set.)
ANTHROPIC_API_KEY=
# CLAUDE_MODEL=claude-sonnet-5-5
# SITE_MODEL=claude-sonnet-5-5   (reads deadlines/events/postings off web pages)

# TinyFish (agent.tinyfish.ai/api-keys): Search, Fetch and Agent.
TINYFISH_API_KEY=

# Comma-separated numbers/Apple IDs Scout answers, e.g. +15555550123
ALLOWED_PHONES=

# Optional tuning (milliseconds). Set SCHEDULER_TICK_MS=60000 to test proactive texts quickly.
# SCHEDULER_TICK_MS=300000
# INTERNSHIP_CHECK_MS=7200000
# SITE_CHECK_MS=86400000
# BOARD_CHECK_MS=43200000
# Fallback timezone until a student tells Scout their school (each student then gets their own).
# TZ_NAME=America/New_York
# Simplify tech-internship list (change the term each year).
# INTERNSHIP_TERM=Summer 2027
# SIMPLIFY_LISTINGS_URL=https://raw.githubusercontent.com/SimplifyJobs/Summer2027-Internships/dev/.github/scripts/listings.json
# Custom Agent step limits need TinyFish's beta program.
# TINYFISH_CUSTOM_STEPS=1
