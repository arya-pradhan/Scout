# Top-level Spectrum credentials (from your Photon dashboard).
PROJECT_ID=
PROJECT_SECRET=

# Claude (console.anthropic.com → API keys). Model defaults to claude-haiku-4-5.
ANTHROPIC_API_KEY=
# CLAUDE_MODEL=claude-haiku-4-5   (e.g. claude-sonnet-5-5 for smarter, pricier replies)

# TinyFish (agent.tinyfish.ai/api-keys): Search, Fetch and Agent.
TINYFISH_API_KEY=

# Comma-separated numbers/Apple IDs the bot answers, e.g. +19195551234
ALLOWED_PHONES=

# Optional tuning (milliseconds). Set SCHEDULER_TICK_MS=60000 to test proactive texts quickly.
# SCHEDULER_TICK_MS=300000
# INTERNSHIP_CHECK_MS=7200000
# SITE_CHECK_MS=86400000
# TZ_NAME=America/New_York
